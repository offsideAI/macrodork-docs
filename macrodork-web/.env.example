# Server-only settings. Never put Stripe secrets in a VITE_ variable.
HOST=127.0.0.1
PORT=4242
PUBLIC_ORIGIN=http://localhost:5173
PREORDERS_ENABLED=false
ALLOW_LIVE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Supported currencies: cad, usd, eur, gbp. Fixed one-time Stripe Price, no coupons.
PREORDER_CURRENCY=cad
# deposit or full. No default amount is invented; amount is read from Stripe Price.
PREORDER_MODE=
PREORDER_TERMS_VERSION=
PREORDER_TERMS=
PREORDER_REFUND_POLICY=
PREORDER_DELIVERY_ESTIMATE=
# State any remaining balance and how tax/shipping are treated in today's amount.
PREORDER_BALANCE_STATEMENT=
MERCHANT_NAME=
SUPPORT_EMAIL=
PREORDER_PRIVACY_NOTICE=
# ISO country codes supported by Stripe; only countries approved for the offer.
PREORDER_COUNTRIES=
# Production requires an absolute path on persistent private storage.
# ORDER_DB_PATH=/var/lib/mark1/orders.sqlite
# NODE_ENV=production
# Set only for a known reverse-proxy topology; do not blindly trust forwarded headers.
# TRUST_PROXY_HOPS=1
